# Heavy caches live on drive D (drive C is almost full)
HF_HOME=D:\VScode_projects\hf-cache
PIP_CACHE_DIR=D:\VScode_projects\pip-cache
UV_CACHE_DIR=D:\VScode_projects\uv-cache
PYTHONIOENCODING=utf-8
# LLM server (llama.cpp, OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODELS_DIR=D:\VScode_projects\llm-models
