# Copy to .env and adjust. Every value is optional: without it the defaults of the libraries are used.

# Heavy caches. The development machine keeps them off the system drive; set your own paths or
# delete these lines to use the standard locations.
HF_HOME=D:\VScode_projects\hf-cache
PIP_CACHE_DIR=D:\VScode_projects\pip-cache
UV_CACHE_DIR=D:\VScode_projects\uv-cache
MTEB_CACHE=D:\VScode_projects\mteb-cache

# Local LLM server for question generation (llama.cpp, OpenAI-compatible API)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODELS_DIR=D:\VScode_projects\llm-models
LLAMA_DIR=D:\VScode_projects\llama.cpp\b11052

# Hugging Face. Never commit a token; `hf auth login` writes one to the path below, which has to be
# named explicitly when HF_HOME is moved.
HF_TOKEN=
# HF_TOKEN_PATH=<your home>/.cache/huggingface/token

# Optional: the eval/questions.jsonl of github.com/alekseevpavel04/tk-rf-rag. When set, its 30
# questions are evaluated as the `external` query set; when unset, that set is simply skipped.
# TK_RF_RAG_QUESTIONS=../tk-rf-rag/eval/questions.jsonl
