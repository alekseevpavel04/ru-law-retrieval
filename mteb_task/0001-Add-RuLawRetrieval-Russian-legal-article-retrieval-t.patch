new file mode 100644
index 0000000..5bf91b5
--- /dev/null
+++ b/mteb/tasks/retrieval/rus/ru_law_retrieval.py
@@ -0,0 +1,43 @@
+from mteb.abstasks.retrieval import AbsTaskRetrieval
+from mteb.abstasks.task_metadata import TaskMetadata
+
+
+class RuLawRetrieval(AbsTaskRetrieval):
+    metadata = TaskMetadata(
+        name="RuLawRetrieval",
+        description=(
+            "Retrieval of articles of Russian codes of law (Labour, Civil, Housing, Administrative Offences, "
+            "Family codes and the Consumer Rights Protection Law; 3,786 articles, edition of September 2026) "
+            "for questions of three styles: everyday situations without legal terms, short search queries and "
+            "lawyer questions. Test queries are generated by YandexGPT-5-Lite-8B from the article text and "
+            "filtered by an LLM judge of another family (Qwen3-8B). The test set has three slices: articles "
+            "seen in the training split, held-out articles of the same codes and two codes unseen in training."
+        ),
+        reference="https://github.com/alekseevpavel04/ru-law-retrieval",
+        dataset={
+            "path": "alekseevpavel04/ru-law-retrieval",
+            "revision": "96f4fe0396deab693bd2e1cdeda1f276b5a1b5d4",
+        },
+        type="Retrieval",
+        category="t2t",
+        modalities=["text"],
+        eval_splits=["test"],
+        eval_langs=["rus-Cyrl"],
+        main_score="ndcg_at_10",
+        date=("2026-09-01", "2026-09-19"),
+        domains=["Legal", "Written"],
+        task_subtypes=["Article retrieval"],
+        license="multiple",  # law texts: public domain (Civil Code art. 1259); queries: YandexGPT-5-Lite license; code: MIT
+        annotations_creators="LM-generated and reviewed",
+        dialect=[],
+        sample_creation="LM-generated and verified",
+        bibtex_citation=r"""
+@misc{rulawretrieval2026,
+  author = {Alekseev, Pavel},
+  title = {RuLawRetrieval: Russian legal article retrieval benchmark},
+  url = {https://github.com/alekseevpavel04/ru-law-retrieval},
+  year = {2026},
+}
+""",
+        prompt={"query": "Given a question about Russian law, retrieve the article of law that answers it"},
+    )
